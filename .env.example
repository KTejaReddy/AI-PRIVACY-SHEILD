# =============================================================================
# AI PRIVACY SHIELD — environment configuration
# Copy this file to backend/.env and adjust as needed. All variables are
# optional; defaults are shown. The backend reads AIPS_* variables.
# =============================================================================

# ---- server ---------------------------------------------------------------
# AIPS_HOST=127.0.0.1
# AIPS_PORT=8000
# AIPS_DEBUG=0
# AIPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- hardware --------------------------------------------------------------
# auto = use CUDA when available, otherwise CPU. Force with cuda / cpu.
# AIPS_DEVICE=auto

# ---- profile (production vs research) --------------------------------------
# production: protection engine only, in-app benchmark off, fast user runs.
# research:   full benchmark/red-team environment (scripts/benchmark_*.py).
# AIPS_PROFILE=production

# ---- upload limits ---------------------------------------------------------
# AIPS_MAX_UPLOAD_MB=25
# AIPS_MAX_IMAGE_DIMENSION=6000

# ---- face detection ---------------------------------------------------------
# AIPS_FACE_CONFIDENCE=0.6
# AIPS_FACE_CROP_MARGIN=2.2
# AIPS_FACE_REGION_DILATE=1.35

# ---- person detection -------------------------------------------------------
# HOG (full-body, no download) + neural Faster R-CNN (torchvision COCO weights).
# AIPS_PERSON_CONFIDENCE=0.2
# AIPS_PERSON_REGION_DILATE=1.15
# AIPS_PERSON_REGION_WEIGHT=0.6
# AIPS_CONTEXT_MASK_WEIGHT=0.18
# AIPS_PERSON_DETECT_MAX_DIM=720
# AIPS_NEURAL_PERSON_CONFIDENCE=0.5
# AIPS_NEURAL_PERSON_MAX_DIM=800

# ---- adversarial optimization ----------------------------------------------
# L-inf bound on the perturbation (0..1 pixel scale). 0.035 = ~9/255 per channel.
# AIPS_EPSILON=0.035
# AIPS_ITERATIONS_GPU=70
# AIPS_ITERATIONS_CPU=35
# AIPS_OPT_LR=0.03
# AIPS_OPT_MARGIN=0.65
# AIPS_OPT_ROBUSTNESS_INTERVAL=1      # differentiable variants every iteration
# AIPS_OPT_EARLY_STOP_PATIENCE=10
# AIPS_OPT_SEED=0

# Multi-objective loss weights
# AIPS_W_IDENTITY=0.6     # face-identity disruption (supporting)
# AIPS_W_VISION=0.7       # global vision-feature disruption
# AIPS_W_SSIM=0.10
# AIPS_W_MSE=0.05
# AIPS_W_ROBUSTNESS=0.60
# AIPS_W_PERTURBATION=0.05
# AIPS_VISION_MARGIN=0.55  # target L2 distance for global vision features

# ---- detection-suppression objectives (phase 1 + 2) --------------------------
# AIPS_W_FACE_DET=0.9        # differentiable MTCNN surrogate weight (phase 1)
# AIPS_W_PERSON_DET=0.30     # HOG suppression weight (phase 2)
# AIPS_W_MTCNN_DET=0.40      # MTCNN cascade suppression weight (phase 2)
# AIPS_W_NEURAL_PERSON_DET=0.40  # Faster R-CNN suppression weight (phase 2)
# AIPS_DET_BLOB_DIRECTIONS_GPU=10
# AIPS_DET_BLOB_DIRECTIONS_CPU=4
# AIPS_DET_BLOB_COUNT=8
# AIPS_DET_BLOB_SIGMA_MIN=8
# AIPS_DET_BLOB_SIGMA_MAX=28
# AIPS_DET_TEXTURE_FRACTION=0.40   # per-pixel texture share of det directions
# AIPS_DET_BLOB_FRACTION=0.40      # Gaussian blob share (rest = sinusoids)
# AIPS_ONET_LOGIT_TARGET=-1.2      # O-Net logit floor (p=0.23; 0.7 thresh kills face)
# AIPS_RNET_LOGIT_TARGET=-1.0
# AIPS_PNET_LOGIT_TARGET=-2.0

# ---- black-box refinement (phase 2) ------------------------------------------
# Combined gradient: embedding disruption (W_EMB) + detector suppression (W_DET).
# AIPS_W_EMB=0.8
# AIPS_W_DET=0.2
# AIPS_DET_ATTACK_FRACTION=0.25     # share of refinement iters on pure detection
# AIPS_DET_TARGET_FACE=0.35
# AIPS_DET_TARGET_PERSON=0.0
# AIPS_DET_GRAD_INTERVAL_GPU=6
# AIPS_DET_GRAD_INTERVAL_CPU=8
# AIPS_DET_DIRECTIONS_GPU=10
# AIPS_DET_DIRECTIONS_CPU=5
# AIPS_REFINE_DIRECTIONS_GPU=12
# AIPS_REFINE_DIRECTIONS_CPU=6
# AIPS_REFINE_MAX_ITERS_GPU=60
# AIPS_REFINE_MAX_ITERS_CPU=20
# AIPS_REFINE_TRANSFORM_INTERVAL=6

# ---- vision encoder / neural person ------------------------------------------
# AIPS_VISION_ENCODER_ENABLED=1

# ---- verification / robustness ----------------------------------------------
# Embedding distances are L2 on normalized vectors, so they live in [0, 2].
# AIPS_DISRUPT_PASS=0.70
# AIPS_DISRUPT_PARTIAL=0.40
# AIPS_MIN_SSIM=0.90
# AIPS_MIN_PSNR=30.0

# ---- AI-editing protection (primary objective) --------------------------------
# Multi-family Photoguard-style protection + multi-editor benchmark.
# Requires the local models (SD1.5 + InstructPix2Pix + inpainting unet + CLIP) —
# see docs/editing-protection.md. Run scripts/download_editing_models.py.
# AIPS_EDITING_ENABLED=1
# AIPS_EDITING_SURROGATE_ENABLED=1     # anti-diffusion optimizer (SD1.5)
# AIPS_EDITING_BENCHMARK_ENABLED=0     # in-app benchmark (research profile default 1)
# AIPS_EDITING_IP2P_ENABLED=1          # InstructPix2Pix (held-out instruction editor)
# AIPS_EDITING_INPAINTING_ENABLED=1    # masked inpainting (real region masks)
# AIPS_EDITING_IMG2IMG_ENABLED=1       # SD1.5 image-to-image (style/global tasks)
# AIPS_EDITING_IMG2IMG_TASKS=t02_background,t04_lighting,t05_sketch
# AIPS_EDITING_IMG2IMG_STRENGTH=0.6
# AIPS_EDITING_RESOLUTION=512          # editor resolution (lower = faster)
# AIPS_EDITING_STEPS=15                # diffusion inference steps
# AIPS_EDITING_GUIDANCE=7.5
# AIPS_EDITING_IMAGE_GUIDANCE=1.5
# AIPS_EDITING_SEED=42                 # fixed across original & protected (fair comparison)
# AIPS_EDITING_SEEDS=42,7,1337         # extra seeds for the benchmark script
# AIPS_EDITING_TASKS=t01_shirt_color,t02_background,t03_hat,t05_sketch
# Edit-success scoring: task-specific pixel metric (primary) + CLIP (auxiliary).
# AIPS_W_EDITING_TASK_METRIC=0.6
# AIPS_W_EDITING_CLIP=0.4
# AIPS_EDITING_CLIP_DELTA_SCALE=0.1    # maps CLIP cosine deltas to the 0..1 scale
# Edit success measured AFTER real transformations (protected -> transform -> editor).
# AIPS_EDITING_ROBUSTNESS_ENABLED=1
# AIPS_EDITING_ROBUSTNESS_TRANSFORMS=jpeg_compression,resize
# AIPS_EDITING_ROBUSTNESS_TASKS=t01_shirt_color,t02_background
# AIPS_EDITING_MASK_KINDS=shirt,hair,background,person,irregular  # benchmark script masks
# AIPS_EDITING_SURROGATE_RESOLUTION=256   # attack resolution (speed)
# AIPS_EDITING_SURROGATE_TIMESTEP=250     # 0..1000 denoising timestep
# AIPS_EDITING_SURROGATE_ITERS_GPU=6
# AIPS_EDITING_SURROGATE_ITERS_CPU=2
# AIPS_EDITING_SURROGATE_LR=0.012
# AIPS_EDITING_SURROGATE_EPSILON_FRACTION=0.5  # share of AIPS_EPSILON (approx 4.5/255)
# AIPS_EDITING_MIN_SSIM=0.90            # stage reverted below this floor

# ---- multi-family protection (ONE perturbation, several AI families) ----------
# Identity-reference / face-swap loss weight vs the diffusion term (family E/F).
# AIPS_EDITING_IDENTITY_ENABLED=1
# AIPS_EDITING_IDENTITY_WEIGHT=0.6
# Global vision-encoder loss weight vs the diffusion term (family I).
# AIPS_EDITING_VISION_ENABLED=1
# AIPS_EDITING_VISION_WEIGHT=0.35

# ---- adaptive red-team loop (research profile) -------------------------------
# Rounds of protect -> probe families -> raise weakest weight -> re-protect.
# AIPS_RED_TEAM_ROUNDS=0
# Stop when the mean family-score gain drops below this.
# AIPS_RED_TEAM_MIN_GAIN=0.005
# Per-term weight cap / step multiplier.
# AIPS_RED_TEAM_MAX_WEIGHT=2.5
# AIPS_RED_TEAM_WEIGHT_STEP=1.5

# ---- C2PA provenance (optional second defense layer, NOT an AI blocker) -------
# Embeds a cryptographically signed provenance manifest into the protected PNG
# (content hash, operation, timestamp). A local self-signed Ed25519 keypair is
# generated on first use under backend/data/c2pa/ so it works offline.
# AIPS_C2PA_ENABLED=1
# AIPS_C2PA_KEY=      # PEM private key for your own signing identity (optional)
# AIPS_C2PA_CERT=     # PEM certificate chain for your own signing identity (optional)

# ---- sensitive content -------------------------------------------------------
# AIPS_OCR_ENABLED=1
# AIPS_OCR_MAX_DIMENSION=1280
# AIPS_SENSITIVE_REGION_BLUR=25

# ---- output ------------------------------------------------------------------
# png (lossless, default) or jpeg (lossy).
# AIPS_OUTPUT_FORMAT=png
# AIPS_JPEG_QUALITY=95

# ---- session / temp lifecycle --------------------------------------------------
# AIPS_SESSION_TTL_SECONDS=1800
# AIPS_JANITOR_INTERVAL_SECONDS=300

# ---- paths (defaults point inside the project) ----------------------------------
# AIPS_MODELS_DIR=<project>/models
# AIPS_TMP_DIR=<project>/backend/.tmp
